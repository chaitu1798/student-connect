# Environment Configuration
PROJECT_NAME="Student Information & Internship Management System"
VERSION="1.0.0"
ENVIRONMENT="development"  # Options: development | testing | production

# Security Configuration
# In production, SECRET_KEY MUST be explicitly configured with at least 32 characters.
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
# Do NOT commit production secrets to version control.
SECRET_KEY="REPLACE_WITH_GENERATED_32_CHAR_SECRET_KEY_FOR_PRODUCTION"
ACCESS_TOKEN_EXPIRE_MINUTES=30  # Recommended 15-30 minutes for enterprise session security

# AES-256-GCM Data Encryption Key for sensitive fields (Aadhaar, PAN)
# Generate a 256-bit key using: python -c "import secrets; print(secrets.token_hex(32))"
DATA_ENCRYPTION_KEY="REPLACE_WITH_GENERATED_64_HEX_OR_32_CHAR_KEY_FOR_PRODUCTION"

# Trusted Reverse Proxy IPs (Comma-separated for proxy addresses allowed to forward client IPs)
TRUSTED_PROXY_IPS="127.0.0.1,::1"

# CORS Allowed Origins (Comma-separated for multiple URLs)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Database Configuration
# Default local storage: SQLite
DATABASE_URL="sqlite:///./student_portal.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://db_user:strong_password@localhost:5432/student_management_db"

# Admin Initial Credentials (Used on initial bootstrap only)
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD="ChangeMe123!"
DEFAULT_ADMIN_EMAIL="admin@institution.edu"
